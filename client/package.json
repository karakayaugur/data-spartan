{
  "name": "data-spartan-client",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng serve",
    "test": "ng test",
    "storybook": "ng run data-spartan:storybook",
    "build-storybook": "ng run data-spartan:build-storybook",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=text --coverage-reporters=html --coverage-reporters=lcov",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:slow": "PW_SLOW_MO=1000 playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/build": "21.2.30",
    "@angular/cdk": "21.2.14",
    "@angular/cli": "21.2.30",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@lucide/angular": "^1.17.0",
    "camelcase-keys": "^10.0.3",
    "flatpickr": "^4.6.13",
    "open-props": "^1.7.23",
    "rxjs": "~7.8.0",
    "ts-cacheable": "^1.0.19",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.30",
    "@angular/platform-browser-dynamic": "21.2.26",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/angular": "10.6.7",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^31.0.1",
    "storybook": "10.6.7",
    "vitest": "^4.0.8"
  }
}
