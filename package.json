{
  "name": "data-spartan",
  "version": "0.0.0",
  "type": "module",
  "description": "Data Spartan \u2014 Angular client + Express BFF",
  "scripts": {
    "predev": "npm run install-packages",
    "dev": "concurrently -k \"nodemon\" \"npm run watch:client\"",
    "watch:client": "npm --prefix client run watch",
    "build": "NODE_ENV=production npm --prefix client run build",
    "install-packages": "npm ci && npm --prefix client ci && npm --prefix server ci",
    "start": "node server/index.js",
    "clean": "rm -rf client/node_modules/ && rm -rf server/node_modules/ && rm -rf client/dist && rm -rf node_modules/",
    "debug": "concurrently -k \"node --inspect server/index.js\" \"npm run watch:client\"",
    "test": "npm --prefix client test -- --watch=false",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestorybook": "npm --prefix client ci --include=dev",
    "storybook": "npm --prefix client run storybook",
    "prebuild-storybook": "npm --prefix client ci --include=dev",
    "build-storybook": "npm --prefix client run build-storybook",
    "test:ci": "npm --prefix client run test:ci",
    "test:coverage": "npm --prefix client run test:coverage",
    "test:e2e": "npm --prefix client run test:e2e --",
    "test:e2e:headed": "npm --prefix client run test:e2e:headed --",
    "test:e2e:slow": "npm --prefix client run test:e2e:slow --",
    "test:e2e:ui": "npm --prefix client run test:e2e:ui --"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.10.1"
  },
  "volta": {
    "node": "24.18.0"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,html,css,scss,md,yml,yaml}": "prettier --write"
  }
}
